# Production baseline (ADR-012, M4-06). On the VPS copy to `/opt/macy/prod/.env`, chmod 600, and
# replace every CHANGE_ME value. scripts/deploy.sh refuses to deploy while a CHANGE_ME remains.
# Works identically locally with Docker Compose (`localhost` + configurable CADDY_HTTP_PORT /
# CADDY_HTTPS_PORT so macy-staging and macy-prod can run side by side on the same host).

# --- Identity of this environment ---
APP_ENV=production
COMPOSE_PROJECT_NAME=macy-prod

# --- Public address (Caddy obtains the certificate automatically for a real domain) ---
DOMAIN=localhost
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- Image (pushed to GHCR by deploy.yml; APP_TAG is set per release) ---
APP_IMAGE=ghcr.io/CHANGE_ME_OWNER/macy
APP_TAG=latest

# --- Database (never published outside the Compose network) ---
POSTGRES_DB=macy_prod
POSTGRES_USER=owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
# Password for the least-privilege `app` role; deploy.sh applies it after migrations.
APP_DB_PASSWORD=CHANGE_ME_app_role_password
# Password for the least-privilege `retention` role used by nightly `macy purge`.
RETENTION_DB_PASSWORD=CHANGE_ME_retention_role_password

# --- Secrets encryption (back up separately in your password vault; see runbook) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# --- Google OIDC (Streamlit native auth; rendered into /tmp/macy/secrets.toml at startup) ---
# Generate AUTH_COOKIE_SECRET: openssl rand -hex 32
# Google Cloud Console Authorised redirect URI: https://<DOMAIN>[:<CADDY_HTTPS_PORT>]/oauth2callback
AUTH_COOKIE_SECRET=CHANGE_ME_random_64_hex
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_google_client_secret
# Optional override; leave empty to derive automatically from DOMAIN and CADDY_HTTPS_PORT:
AUTH_REDIRECT_URI=
GOOGLE_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

# --- Nightly backups (pg_dump -> offsite storage, 14 days kept; F20 AC4) ---
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
OFFSITE_BACKUP_PATH=./backups/offsite
OFFSITE_SYNC_CMD=

# --- Optional integrations ---
OPENROUTER_API_KEY=
BRAVE_API_KEY=
SENTRY_DSN=
HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=
BACKUP_ALERT_URL=

# --- Model Context Protocol (MCP, M5-06 / ADR-027) ---
MCP_ENABLED=false
COMPOSE_PROFILES=
# Generate: openssl rand -hex 32 (required when MCP_ENABLED=true)
MCP_AUTH_TOKEN=CHANGE_ME_mcp_bearer_token
MCP_ACTOR_EMAIL=

# --- Smoke test ---
# Where deploy.sh probes health after the stack is up (through Caddy, TLS verified unless localhost).
SMOKE_URL=https://localhost:8443/_stcore/health
