# Local development baseline. Copy to `.env` (git-ignored) only if you need to override a default.
# `docker compose up -d` works without any .env: every value below is the built-in default.
# These are throwaway development values. Never reuse them anywhere reachable from a network.

# --- Runtime mode ---
ENVIRONMENT=dev
APP_ENV=development

# --- Database ---
POSTGRES_DB=macy
POSTGRES_USER=owner
POSTGRES_PASSWORD=secret
DATABASE_URL=postgres://app:app_secret@db:5432/macy?sslmode=disable

# --- Image selection (dev builds locally) ---
APP_IMAGE=macy
APP_TAG=latest

# --- Optional Google OIDC (rendered into Streamlit secrets automatically at container startup) ---
# AUTH_COOKIE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
# GOOGLE_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

# --- Optional integrations (tests use fakes when unset) ---
# OPENROUTER_API_KEY=
# BRAVE_API_KEY=
# SENTRY_DSN=
# HEARTBEAT_URL=

# --- Optional private context overlay (ADR-032) ---
# MACY_CONTEXT_DIR=
# MACY_PACKS_DIR=
# MACY_FIXTURES_DIR=
# MACY_DEFAULT_PACK=general
# MACY_DEFAULT_BRAND_FIXTURE=seed_example.yaml
# MACY_USER_AGENT=MacyContentEngine/1.0
# MACY_HOST_CONTEXT_DIR=../context
