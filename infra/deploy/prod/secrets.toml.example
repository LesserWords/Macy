# Optional manual override for Streamlit native OIDC on production (F01, M4-06).
# By default, container startup reads AUTH_COOKIE_SECRET, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, and AUTH_REDIRECT_URI (or DOMAIN + CADDY_HTTPS_PORT) directly
# from `.env` and generates `/tmp/macy/secrets.toml` (via `.streamlit/config.toml` [secrets]).
# Copy to `.streamlit/secrets.toml` (git-ignored, chmod 600) only if you want manual overrides.
#
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application):
#   Authorised redirect URI: https://<your-prod-domain>/oauth2callback
# Provision the initial workspace owner via: macy add-owner <workspace-slug> <owner-email>

[auth]
redirect_uri = "https://localhost:8443/oauth2callback"
cookie_secret = "CHANGE_ME_random_64_hex"

[auth.google]
client_id = "CHANGE_ME.apps.googleusercontent.com"
client_secret = "CHANGE_ME_google_client_secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
